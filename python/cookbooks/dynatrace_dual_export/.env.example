# Copy to .env (gitignored) and fill in. Used by the collector, the examples, and scripts/verify.py.

# Arize AX: Settings > API Keys. The space id is in the space settings.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Arize project for the AI spans. The examples set it as openinference.project.name, and
# the collector adds it to spans from apps that don't.
ARIZE_PROJECT_NAME=ax-dt-example

# Dynatrace: environment URL without a path.
DYNATRACE_ENV_URL=https://{your-environment-id}.live.dynatrace.com
# Ingest token. Platform token (dt0s16.*) scopes: openpipeline:traces:ingest,
# openpipeline:logs:ingest, openpipeline:metrics:ingest. Access token (dt0c01.*)
# scopes: openTelemetryTrace.ingest, logs.ingest, metrics.ingest.
DYNATRACE_API_TOKEN=
# Bearer for platform tokens (dt0s16.*), Api-Token for access tokens (dt0c01.*).
DYNATRACE_AUTH_SCHEME=Bearer

# Only for the example apps.
OPENAI_API_KEY=

# Only for scripts/verify.py (see TESTING.md).
# Platform token with storage:logs:read, storage:metrics:read, storage:spans:read,
# storage:buckets:read.
DYNATRACE_QUERY_TOKEN=
# ax CLI profile to use; empty uses the active profile.
AX_PROFILE=
