# Environment for the collector (docker compose --env-file, or `set -a; source` for the binary).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=my-ai-app

DYNATRACE_ENV_URL=https://{your-environment-id}.live.dynatrace.com
DYNATRACE_API_TOKEN=
# Bearer for platform tokens (dt0s16.*), Api-Token for access tokens (dt0c01.*).
DYNATRACE_AUTH_SCHEME=Bearer

# Optional: how long the Arize root span branch waits before deciding (default 30s).
# ARIZE_ROOT_DECISION_WAIT=30s
