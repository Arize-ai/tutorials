# Required for live receipt extraction.
OPENAI_API_KEY=

# Required to send traces to Arize AX.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=receipt-image-evals

# Public URLs work for the fictional tutorial images. Replace the branch with
# main after the companion pull request is merged. For real receipts, use
# approved private object storage and suitably long-lived signed URLs.
RECEIPT_IMAGE_BASE_URL=https://raw.githubusercontent.com/Arize-ai/tutorials/codex/receipt-image-evals-url-input/python/cookbooks/receipt_image_evals/images

# Optional model overrides. The evaluator model is recorded on spans; AX runs
# the evaluator using the AI integration configured in the AX UI.
RECEIPT_EXTRACTION_MODEL=gpt-5.4-mini
RECEIPT_JUDGE_MODEL=gpt-5.6-luna

# Set to 1 to return local fixture data without calling OpenAI.
RECEIPT_DEMO_MODE=0

# Optional Gradio server settings.
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860
