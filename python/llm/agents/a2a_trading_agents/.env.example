# Copy to .env and fill in. Never commit .env.

# --- Arize AX (required) -------------------------------------------------------------
# Space ID and API key from the Arize AX UI: Settings -> API Keys.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=a2a-trading-agents

# --- Model provider -----------------------------------------------------------------
# vertex  Gemini 2.5 Flash + Llama 3.3 70B on Vertex AI. Needs Google Cloud, below.
# openai  OpenAI models for all three agents. Needs only OPENAI_API_KEY.
MODEL_PROVIDER=vertex

# --- Vertex AI (required when MODEL_PROVIDER=vertex) ---------------------------------
# Vertex AI has no API key. Authenticate with Application Default Credentials:
#   gcloud auth application-default login
# The project needs the Vertex AI API enabled, and Llama 3.3 accepted in Model Garden.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Staging bucket for deploy_agent_engine.py. Defaults to gs://$GOOGLE_CLOUD_PROJECT-agent.
STAGING_BUCKET=

# --- OpenAI (required when MODEL_PROVIDER=openai) ------------------------------------
OPENAI_API_KEY=

# --- Optional overrides -------------------------------------------------------------
# BEAR_MODEL=
# BULL_MODEL=
# ORCHESTRATOR_MODEL=
# BEAR_PORT=8001
# BULL_PORT=8002
