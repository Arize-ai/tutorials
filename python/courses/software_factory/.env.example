# Your helpdesk repo, the app the factory works on. Create it with
#   uv run python -m factory.setup your-github-user/helpdesk
FACTORY_TARGET_REPO=your-github-user/helpdesk

# Arize AX. Use the same space as the Codex harness tracing you installed, so the
# factory's trace and every agent's trace land side by side.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
FACTORY_ARIZE_PROJECT=software-factory

# Optional: turns the trace id the factory prints into a link.
ARIZE_ORG_ID=
ARIZE_PROJECT_ID=

# Optional: Codex models. A fast, cheap model builds, and a stronger one reviews.
# FACTORY_BUILD_MODEL=gpt-6-luna
# FACTORY_REVIEW_MODEL=gpt-6.2-sol
