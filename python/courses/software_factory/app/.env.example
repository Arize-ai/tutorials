# Where the SQLite database lives.
HELPDESK_DATABASE_URL=sqlite:///./helpdesk.db

# Signs the session cookie. Required whenever HELPDESK_ENV isn't dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HELPDESK_SECRET_KEY=
HELPDESK_ENV=dev

# Set to true when the app is served over HTTPS.
HELPDESK_SECURE_COOKIES=false

# Webhooks are sent after each request. Set to false to only queue them.
HELPDESK_DELIVER_WEBHOOKS=true
HELPDESK_WEBHOOK_TIMEOUT_S=5
